#: lib/errors.c:351
msgid "PKCS #11 error in attribute"
msgstr "PKCS #11 属性出错"

#: lib/errors.c:353
msgid "PKCS #11 error in device"
msgstr "PKCS #11 设备出错"

#: lib/errors.c:355
msgid "PKCS #11 error in data"
msgstr "PKCS #11 数据出错"

#: lib/errors.c:357
