msgstr "無法協商出支援的應用協定"

#: lib/alert.c:88
msgid "Certificate is required"
msgstr "需要憑證"

#: lib/errors.c:43
msgid "Could not negotiate a supported cipher suite."
msgstr "無法協商出支援的密碼套件。"

#: lib/errors.c:45
msgid "No or insufficient priorities were set."
msgstr "未設定優先順序或優先順序不足。"

#: lib/errors.c:47
msgid "The cipher type is unsupported."
msgstr "不支援此密碼類型。"

#: lib/errors.c:49
msgid "The certificate and the given key do not match."
msgstr "憑證與給定的金鑰不相符。"

#: lib/errors.c:52
msgid "Could not negotiate a supported compression method."
msgstr "無法協商出支援的壓縮方式。"

#: lib/errors.c:54
msgid "An unknown public key algorithm was encountered."
msgstr "遇到未知的公鑰演算法。"

#: lib/errors.c:57
msgid "An algorithm that is not enabled was negotiated."
msgstr "協商出的演算法尚未啟用。"

#: lib/errors.c:60
msgid "A packet with illegal or unsupported version was received."
msgstr "收到版本不合法或不受支援的封包。"

#: lib/errors.c:63
msgid "The Diffie-Hellman prime sent by the server is not acceptable (not long enough)."
msgstr "伺服器傳送的 Diffie-Hellman 質數無法接受（長度不足）。"

#: lib/errors.c:66
msgid "Error decoding the received TLS packet."
msgstr "解碼收到的 TLS 封包時發生錯誤。"

#: lib/errors.c:69
msgid "A TLS record packet with invalid length was received."
msgstr "收到長度無效的 TLS 記錄封包。"

#: lib/errors.c:71
msgid "The TLS connection was non-properly terminated."
msgstr "TLS 連線未正常終止。"

#: lib/errors.c:74
msgid "The specified session has been invalidated for some reason."
msgstr "指定的工作階段因故失效。"

#: lib/errors.c:77
msgid "GnuTLS internal error."
msgstr "GnuTLS 內部錯誤。"

#: lib/errors.c:79
msgid "A connection with inappropriate fallback was attempted."
msgstr "嘗試了回退方式不當的連線。"

#: lib/errors.c:81
msgid "An illegal TLS extension was received."
msgstr "收到不合法的 TLS 擴充。"

#: lib/errors.c:83
msgid "An required TLS extension was received."
msgstr "收到必要的 TLS 擴充。"

#: lib/errors.c:85
msgid "A TLS fatal alert has been received."
msgstr "收到 TLS 致命警告。"

#: lib/errors.c:87
msgid "An unexpected TLS packet was received."
msgstr "收到非預期的 TLS 封包。"

#: lib/errors.c:89
msgid "Failed to import the key into store."
msgstr "無法將金鑰匯入儲存區。"

#: lib/errors.c:92
msgid "An error was encountered at the TLS Finished packet calculation."
msgstr "計算 TLS Finished 封包時發生錯誤。"

#: lib/errors.c:94 libdane/errors.c:67
msgid "No certificate was found."
msgstr "找不到憑證。"

#: lib/errors.c:96
msgid "Certificate is required."
msgstr "需要憑證。"

#: lib/errors.c:99
msgid "The given DSA key is incompatible with the selected TLS protocol."
msgstr "給定的 DSA 金鑰與所選的 TLS 協定不相容。"

#: lib/errors.c:102
msgid "There is already a crypto algorithm with lower priority."
msgstr "已有優先順序較低的加密演算法。"

#: lib/errors.c:105
msgid "No temporary RSA parameters were found."
msgstr "找不到暫時 RSA 參數。"

#: lib/errors.c:107
msgid "No temporary DH parameters were found."
msgstr "找不到暫時 DH 參數。"

#: lib/errors.c:109
msgid "An unexpected TLS handshake packet was received."
msgstr "收到非預期的 TLS 交握封包。"

#: lib/errors.c:111
msgid "The scanning of a large integer has failed."
msgstr "掃描大整數失敗。"

#: lib/errors.c:113
msgid "Could not export a large integer."
msgstr "無法匯出大整數。"

#: lib/errors.c:115
msgid "Decryption has failed."
msgstr "解密失敗。"

#: lib/errors.c:117
msgid "Encryption has failed."
msgstr "加密失敗。"

#: lib/errors.c:119
msgid "Public key decryption has failed."
msgstr "公鑰解密失敗。"

#: lib/errors.c:121
msgid "Public key encryption has failed."
msgstr "公鑰加密失敗。"

#: lib/errors.c:123
msgid "Public key signing has failed."
msgstr "公鑰簽署失敗。"

#: lib/errors.c:125
msgid "Public key signature verification has failed."
msgstr "公鑰簽章驗證失敗。"

#: lib/errors.c:128
msgid "Decompression of the TLS record packet has failed."
msgstr "TLS 記錄封包解壓縮失敗。"

#: lib/errors.c:130
msgid "Compression of the TLS record packet has failed."
msgstr "TLS 記錄封包壓縮失敗。"

#: lib/errors.c:133
msgid "Internal error in memory allocation."
msgstr "分配記憶體時發生內部錯誤。"

#: lib/errors.c:136
msgid "An unimplemented or disabled feature has been requested."
msgstr "請求了未實作或已停用的功能。"

#: lib/errors.c:138
msgid "Insufficient credentials for that request."
msgstr "該請求的憑據不足。"

#: lib/errors.c:140
msgid "Error in password/key file."
msgstr "密碼／金鑰檔發生錯誤。"

#: lib/errors.c:141
msgid "Wrong padding in PKCS1 packet."
msgstr "PKCS1 封包的填充錯誤。"

#: lib/errors.c:143
msgid "The session or certificate has expired."
msgstr "工作階段或憑證已過期。"

#: lib/errors.c:145
msgid "The certificate is not yet activated."
msgstr "憑證尚未生效。"

#: lib/errors.c:147
msgid "Hashing has failed."
msgstr "雜湊失敗。"

#: lib/errors.c:148
msgid "Base64 decoding error."
msgstr "Base64 解碼錯誤。"

#: lib/errors.c:150
msgid "Base64 unexpected header error."
msgstr "Base64 出現非預期的標頭錯誤。"

#: lib/errors.c:152
msgid "Base64 encoding error."
msgstr "Base64 編碼錯誤。"

#: lib/errors.c:154
msgid "Parsing error in password/key file."
