msgstr "在永久儲存區中找不到 TPM 金鑰。"

#: lib/errors.c:332
msgid "Cannot initialize a session with the TPM."
msgstr "無法以 TPM 初始化工作階段。"

#: lib/errors.c:334
msgid "PKCS #11 error."
msgstr "PKCS #11 錯誤。"

#: lib/errors.c:336
msgid "PKCS #11 initialization error."
msgstr "PKCS #11 初始化錯誤。"

#: lib/errors.c:338
msgid "Error in parsing."
msgstr "解析時發生錯誤。"

#: lib/errors.c:340
msgid "Error in provided PIN."
msgstr "提供的 PIN 發生錯誤。"

#: lib/errors.c:342
