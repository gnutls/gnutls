msgstr "提供給 TPM 的 SRK 密碼發生錯誤。"

#: lib/errors.c:345
msgid "Error in provided password for key to be loaded in TPM."
msgstr "要載入 TPM 的金鑰密碼發生錯誤。"

#: lib/errors.c:347
msgid "PKCS #11 error in slot"
msgstr "PKCS #11 插槽錯誤"

#: lib/errors.c:349
