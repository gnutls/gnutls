msgstr "執行緒鎖定錯誤"

#: lib/errors.c:351
msgid "PKCS #11 error in attribute"
msgstr "PKCS #11 屬性錯誤"

#: lib/errors.c:353
msgid "PKCS #11 error in device"
msgstr "PKCS #11 裝置錯誤"

#: lib/errors.c:355
msgid "PKCS #11 error in data"
